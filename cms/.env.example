# Sanity project (create at https://www.sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=development

# Display name in the Sanity Studio sidebar
SANITY_STUDIO_TITLE=Content Studio

# Required for migration scripts and translation/SEO tooling (Editor or Admin token)
SANITY_API_TOKEN=

# Optional: OpenAI-powered page translation and SEO description generation
OPENAI_API_KEY=

# Optional: set to "mock" to skip OpenAI calls in generatePageTranslations migration
TRANSLATE_MODE=

# Optional: Deploy tool plugin — Vercel deploy hook URL and dashboard link
SANITY_STUDIO_DEPLOY_HOOK=
SANITY_STUDIO_VERCEL_LINK=
